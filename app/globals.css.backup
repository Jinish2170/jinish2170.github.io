@tailwind base;
@tailwind components;
@tailwind utilities;

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@300;400;500;600;700&display=swap');

@layer base {
  :root {
    /* === PREMIUM LIGHT THEME === */
    --background: 0 0% 100%;
    --foreground: 222 14% 12%;
    
    --card: 0 0% 98%;
    --card-foreground: 222 14% 12%;
    
    --popover: 0 0% 100%;
    --popover-foreground: 222 14% 12%;
    
    --primary: 221 83% 53%;
    --primary-foreground: 0 0% 100%;
    
    --secondary: 220 14% 96%;
    --secondary-foreground: 222 14% 12%;
    
    --muted: 220 14% 96%;
    --muted-foreground: 220 8% 46%;
    
    --accent: 45 87% 53%;
    --accent-foreground: 222 14% 12%;
    
    --destructive: 0 84% 60%;
    --destructive-foreground: 0 0% 100%;
    
    --border: 220 13% 90%;
    --input: 220 13% 90%;
    --ring: 221 83% 53%;
    --radius: 0.5rem;
    
    /* === PREMIUM SURFACE SYSTEM === */
    --surface: 0 0% 97%;
    --surface-hover: 0 0% 95%;
    --bg-primary: 0 0% 100%;
    --bg-secondary: 220 14% 98%;
    --bg-tertiary: 220 14% 96%;
    --bg-card: 0 0% 98%;
    --bg-elevated: 0 0% 100%;
    
    /* === PREMIUM TEXT COLORS === */
    --text-primary: 222 14% 12%;
    --text-secondary: 220 8% 46%;
    --text-muted: 220 8% 56%;
    
    /* === PREMIUM BORDER SYSTEM === */
    --card-border: 220 13% 88%;
    --glass-bg: 0 0% 100%;
    --glass-border: 220 13% 85%;
    --glass-strong: 0 0% 95%;
    
    /* === NAVBAR === */
    --navbar-bg: 0 0% 100%;
  }

  .dark {
    /* === PREMIUM DARK THEME === */
    --background: 222 14% 4%;
    --foreground: 0 0% 98%;
    
    --card: 222 14% 7%;
    --card-foreground: 0 0% 98%;
    
    --popover: 222 14% 6%;
    --popover-foreground: 0 0% 98%;
    
    --primary: 221 83% 53%;
    --primary-foreground: 0 0% 100%;
    
    --secondary: 222 14% 12%;
    --secondary-foreground: 0 0% 98%;
    
    --muted: 222 14% 12%;
    --muted-foreground: 220 8% 64%;
    
    --accent: 45 87% 53%;
    --accent-foreground: 222 14% 4%;
    
    --destructive: 0 62% 30%;
    --destructive-foreground: 0 0% 98%;
    
    --border: 222 13% 16%;
    --input: 222 13% 16%;
    --ring: 221 83% 53%;
    
    /* === PREMIUM SURFACE SYSTEM (DARK) === */
    --surface: 222 14% 8%;
    --surface-hover: 222 14% 10%;
    --bg-primary: 222 14% 4%;
    --bg-secondary: 222 14% 6%;
    --bg-tertiary: 222 14% 8%;
    --bg-card: 222 14% 7%;
    --bg-elevated: 222 14% 9%;
    
    /* === PREMIUM TEXT COLORS (DARK) === */
    --text-primary: 0 0% 98%;
    --text-secondary: 220 8% 64%;
    --text-muted: 220 8% 56%;
    
    /* === PREMIUM BORDER SYSTEM (DARK) === */
    --card-border: 222 13% 18%;
    --glass-bg: 222 14% 8%;
    --glass-border: 222 13% 20%;
    --glass-strong: 222 14% 10%;
    
    /* === NAVBAR (DARK) === */
    --navbar-bg: 222 14% 4%;
  }

  /* === PREMIUM ANIMATIONS (Subtle & Sophisticated) === */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(20px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes slideInLeft {
    from { opacity: 0; transform: translateX(-20px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  @keyframes pulseSoft {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.8; }
  }

  * {
    @apply border-border;
  }

  body {
    @apply bg-background text-foreground;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
    font-feature-settings: 'cv02', 'cv03', 'cv04', 'cv11';
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  html {
    scroll-behavior: smooth;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: 'Space Grotesk', sans-serif;
    letter-spacing: -0.02em;
  }

  /* Premium focus styles */
  *:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 2px;
    border-radius: calc(var(--radius) - 2px);
  }
}

@layer components {
  /* === PREMIUM CARD SYSTEM === */
  .premium-card {
    background: hsl(var(--bg-card));
    border: 1px solid hsl(var(--card-border));
    border-radius: var(--radius);
    padding: 2rem;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .premium-card:hover {
    background: hsl(var(--surface-hover));
    border-color: hsl(var(--border));
    box-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }

  .dark .premium-card:hover {
    box-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.3);
  }

  /* === PREMIUM SECTION SYSTEM === */
  .section-padding {
    @apply py-32 md:py-40 lg:py-48;
  }

  .section-container {
    @apply container mx-auto px-4 sm:px-6 lg:px-8;
    max-width: 1200px; /* 6xl equivalent */
  }

  /* === PREMIUM TYPOGRAPHY === */
  .heading-xl {
    @apply text-4xl md:text-6xl lg:text-7xl font-bold tracking-tight;
    line-height: 1.1;
  }

  .heading-lg {
    @apply text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight;
    line-height: 1.2;
  }

  .heading-md {
    @apply text-2xl md:text-3xl font-semibold tracking-tight;
    line-height: 1.3;
  }

  .heading-sm {
    @apply text-xl md:text-2xl font-semibold tracking-tight;
    line-height: 1.4;
  }

  .body-lg {
    @apply text-lg md:text-xl leading-relaxed;
    color: hsl(var(--text-secondary));
  }

  .body-md {
    @apply text-base md:text-lg leading-relaxed;
    color: hsl(var(--text-secondary));
  }

  .body-sm {
    @apply text-sm md:text-base leading-relaxed;
    color: hsl(var(--text-muted));
  }

  /* === PREMIUM BUTTON SYSTEM === */
  .btn-premium {
    background: linear-gradient(135deg, hsl(var(--royal-500)), hsl(var(--royal-600)));
    color: hsl(var(--primary-foreground));
    padding: 0.75rem 2rem;
    border-radius: calc(var(--radius) + 2px);
    font-weight: 600;
    transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
    border: none;
    cursor: pointer;
  }

  .btn-premium:hover {
    box-shadow: 0 0 20px hsla(var(--royal-500), 0.3);
    transform: translateY(-1px);
  }

  .btn-premium:active {
    transform: translateY(0);
  }

  .btn-premium-outline {
    background: transparent;
    color: hsl(var(--text-primary));
    padding: 0.75rem 2rem;
    border-radius: calc(var(--radius) + 2px);
    font-weight: 600;
    border: 1px solid hsl(var(--border));
    cursor: pointer;
    transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn-premium-outline:hover {
    background: hsl(var(--surface));
    border-color: hsl(var(--royal-500));
    color: hsl(var(--royal-500));
  }

  /* Project Card */
  .project-card {
    @apply relative bg-card border border-border/50 rounded-xl overflow-hidden transition-all duration-300 hover:shadow-2xl hover:border-border hover:-translate-y-2;
  }

  .project-card-image {
    @apply w-full h-48 object-cover transition-transform duration-300;
  }

  .project-card:hover .project-card-image {
    @apply scale-105;
  }

  .project-card-content {
    @apply p-6;
  }

  /* Navigation */
  .nav-blur {
    @apply bg-background/80 backdrop-blur-md border-b border-border/50;
  }

  /* Gradient Text */
  .gradient-text {
    @apply bg-gradient-to-r from-blue-600 via-purple-600 to-cyan-600 bg-clip-text text-transparent;
  }

  /* Grid Layouts */
  .project-grid {
    @apply grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8;
  }

  .two-column-grid {
    @apply grid grid-cols-1 lg:grid-cols-2 gap-16 items-center;
  }

  /* Animations */
  .fade-in {
    @apply opacity-0 translate-y-6 transition-all duration-700 ease-out;
  }

  .fade-in.in-view {
    @apply opacity-100 translate-y-0;
  }

  /* Focus States */
  .focus-ring {
    @apply focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 focus:ring-offset-background;
  }

  /* Skill bars for legacy compatibility */
  .skill-bar-container {
    @apply w-full bg-muted rounded-full h-2 overflow-hidden;
  }

  .skill-bar {
    @apply h-full bg-gradient-to-r from-blue-600 to-purple-600 rounded-full transition-all duration-1000 ease-out;
  }
}

@layer utilities {
  /* Premium Animation Classes */
  .bg-size-200 {
    background-size: 200%;
  }
  
  .animate-gradient-x {
    animation: gradient-x 4s ease infinite;
  }
  
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }
  
  .animate-glow {
    animation: glow 2s ease-in-out infinite alternate;
  }

  /* Custom utilities for modern aesthetic */
  .text-balance {
    text-wrap: balance;
  }
  
  .animation-delay-200 {
    animation-delay: 200ms;
  }
  
  .animation-delay-300 {
    animation-delay: 300ms;
  }
  
  .animation-delay-500 {
    animation-delay: 500ms;
  }
}

/* Custom animations */
@keyframes fade-up {
  from {
    opacity: 0;
    transform: translateY(24px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.animate-fade-up {
  animation: fade-up 0.6s ease-out forwards;
}

.animate-fade-in {
  animation: fade-in 0.6s ease-out forwards;
}

/* Responsive utilities */
@media (max-width: 640px) {
  .section-padding {
    @apply py-16;
  }
}

/* Professional Background Animations */
@keyframes slideRight {
  0% { transform: translateX(-50%) skewY(-1deg); opacity: 0; }
  50% { opacity: 1; }
  100% { transform: translateX(50%) skewY(-1deg); opacity: 0; }
}

@keyframes slideLeft {
  0% { transform: translateX(50%) skewY(1deg); opacity: 0; }
  50% { opacity: 1; }
  100% { transform: translateX(-50%) skewY(1deg); opacity: 0; }
}

/* Premium Animation Keyframes */
@keyframes gradient-x {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-20px); }
}

@keyframes glow {
  0% { box-shadow: 0 0 5px rgba(59, 130, 246, 0.5); }
  100% { box-shadow: 0 0 20px rgba(59, 130, 246, 0.8), 0 0 30px rgba(147, 51, 234, 0.4); }
}

@keyframes shimmer {
  0% { background-position: -400px 0; }
  100% { background-position: 400px 0; }
}

@keyframes floatSlow {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-10px) rotate(2deg); }
}

@keyframes pulseSoft {
  0%, 100% { opacity: 0.3; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(1.05); }
}

@keyframes architecturalRotate {
  0% { transform: rotate(0deg); opacity: 0.1; }
  50% { opacity: 0.3; }
  100% { transform: rotate(360deg); opacity: 0.1; }
}

/* Advanced Background Utilities */
.bg-gradient-radial {
  background: radial-gradient(circle, var(--tw-gradient-stops));
}

.bg-gradient-conic {
  background: conic-gradient(var(--tw-gradient-stops));
}

.backdrop-blur-soft {
  backdrop-filter: blur(2px) saturate(150%);
}

.shadow-professional {
  box-shadow: 
    0 1px 3px 0 rgba(0, 0, 0, 0.1),
    0 1px 2px 0 rgba(0, 0, 0, 0.06),
    0 0 0 1px rgba(0, 0, 0, 0.02);
}

.shadow-professional-lg {
  box-shadow: 
    0 10px 15px -3px rgba(0, 0, 0, 0.1),
    0 4px 6px -2px rgba(0, 0, 0, 0.05),
    0 0 0 1px rgba(0, 0, 0, 0.02);
}

.transition-professional {
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.transition-smooth {
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
